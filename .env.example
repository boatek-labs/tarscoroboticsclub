# TRC Platform — Environment Variables
# Copy this file to .env and fill in real values before running the server.

# Server
PORT=3000
NODE_ENV=development

# JWT auth — use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret_string

# OpenRouter (AI study assistant, lesson explanations, Q&A help)
OPENROUTER_KEY=sk-or-your-key-here
OPENROUTER_MODEL=deepseek/deepseek-chat

# Optional: Paystack (if adding paid merchandise/events later)
# PAYSTACK_SECRET_KEY=sk_test_xxx
# PAYSTACK_PUBLIC_KEY=pk_test_xxx
