# Neon PostgreSQL connection string (Neon dashboard -> Connection Details)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Required in production: use a long, random secret (at least 32 characters)
JWT_SECRET=replace-with-a-long-random-secret

# Optional initial administrator credentials (used only when database has no users)
INITIAL_ADMIN_EMAIL=admin@tarsco.edu
INITIAL_ADMIN_PASSWORD=replace-this-immediately
